# Passport / Atomic API Configuration
# Copy this file to .env and fill in your credentials.

# The Passport instance hostname
INSTANCE_HOST=api.example.com

# OAuth client credentials (application-level access)
# In your Passport admin, create a new Integration of type "API/OpenID"  and copy the Client ID and Client Secret here.
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
